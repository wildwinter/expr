{
  "name": "@wildwinter/toolkit",
  "version": "0.0.0",
  "description": "Small shared pieces of the authoring tooling: opaque ids, a stable hash, JSON5 source parsing, find/replace matching, and the archive guards. Nothing here runs in a game.",
  "type": "module",
  "license": "MIT",
  "author": "Ian Thomas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildwinter/expr.git",
    "directory": "packages/toolkit"
  },
  "keywords": [
    "ids",
    "hash",
    "json5",
    "zip",
    "tooling"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./archive": {
      "types": "./dist/archive.d.ts",
      "import": "./dist/archive.js",
      "require": "./dist/archive.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "json5": "^2.2.3"
  }
}
