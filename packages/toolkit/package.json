{
  "name": "@wildwinter/toolkit",
  "version": "0.4.0",
  "description": "Small shared pieces of the authoring tooling: opaque ids, Game IDs, a stable hash, JSON5 source parsing, find/replace matching, the archive guards, and (in ./extensions) the spec and merge for Patter extensions and Storylet extensions. Nothing here runs in a game.",
  "type": "module",
  "license": "MIT",
  "author": "Ian Thomas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildwinter/expr.git",
    "directory": "packages/toolkit"
  },
  "keywords": [
    "ids",
    "hash",
    "json5",
    "zip",
    "tooling",
    "extensions",
    "merge",
    "version-control"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./archive": {
      "types": "./dist/archive.d.ts",
      "import": "./dist/archive.js",
      "require": "./dist/archive.cjs"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.js",
      "require": "./dist/extensions.cjs"
    },
    "./vcs": {
      "types": "./dist/vcs.d.ts",
      "import": "./dist/vcs.js",
      "require": "./dist/vcs.cjs"
    }
  },
  "files": [
    "dist",
    "conformance",
    "extensions.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "json5": "^2.2.3"
  },
  "peerDependencies": {
    "@wildwinter/expr": ">=0.6.0 <1.0.0",
    "@wildwinter/scoperegistry": ">=0.9.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@wildwinter/expr": {
      "optional": true
    },
    "@wildwinter/scoperegistry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@wildwinter/expr": "*",
    "@wildwinter/scoperegistry": "*"
  }
}
