{
  "about": "Manifest validation. Each case gives a manifest and every problem manifestProblems reports for it, by path and code, in the order reported. A case with no problems is a manifest that must pass.",
  "cases": [
    {
      "name": "a minimal manifest passes",
      "manifest": {
        "schema": "wildwinter/extension@0",
        "id": "probe",
        "name": "Probe",
        "version": "1.0.0",
        "targets": {
          "storylets": {
            "card": {
              "fields": [
                {
                  "name": "mood",
                  "type": "text"
                }
              ]
            }
          }
        }
      },
      "problems": []
    },
    {
      "name": "every type passes together",
      "manifest": {
        "schema": "wildwinter/extension@0",
        "id": "probe",
        "name": "Probe",
        "version": "2.1.0",
        "docs": "https://example.com/probe",
        "targets": {
          "storylets": {
            "card": {
              "fields": [
                {
                  "name": "note",
                  "type": "text",
                  "label": "Note",
                  "help": "A line for the crew."
                },
                {
                  "name": "body",
                  "type": "multiline",
                  "editorOnly": true
                },
                {
                  "name": "weight",
                  "type": "number",
                  "min": 0,
                  "max": 10,
                  "default": 1
                },
                {
                  "name": "loud",
                  "type": "boolean",
                  "required": true
                },
                {
                  "name": "tone",
                  "type": "enum",
                  "values": [
                    "calm",
                    "tense"
                  ],
                  "valueHelp": {
                    "calm": "Unhurried."
                  }
                },
                {
                  "name": "marks",
                  "type": "flags",
                  "values": [
                    "night",
                    "rain"
                  ],
                  "default": [
                    "rain"
                  ]
                },
                {
                  "name": "act",
                  "type": "quality",
                  "stages": [
                    "setup",
                    "turn",
                    "close"
                  ],
                  "renamedStages": {
                    "opening": "setup"
                  }
                },
                {
                  "name": "next",
                  "type": "reference",
                  "to": "card"
                },
                {
                  "name": "cue",
                  "type": "record",
                  "fields": [
                    {
                      "name": "sound",
                      "type": "text"
                    },
                    {
                      "name": "gain",
                      "type": "number"
                    }
                  ]
                },
                {
                  "name": "byTag",
                  "type": "map",
                  "key": {
                    "type": "reference",
                    "to": "tag"
                  },
                  "of": {
                    "type": "number"
                  }
                },
                {
                  "name": "byName",
                  "type": "map",
                  "key": {
                    "type": "text"
                  },
                  "of": {
                    "type": "record",
                    "fields": [
                      {
                        "name": "look",
                        "type": "text"
                      }
                    ]
                  }
                },
                {
                  "name": "beats",
                  "type": "list",
                  "id": "id",
                  "of": {
                    "type": "record",
                    "fields": [
                      {
                        "name": "id",
                        "type": "text"
                      },
                      {
                        "name": "at",
                        "type": "number"
                      }
                    ]
                  }
                },
                {
                  "name": "words",
                  "type": "list",
                  "of": {
                    "type": "text"
                  }
                }
              ]
            },
            "project": {
              "fields": [
                {
                  "name": "studio",
                  "type": "text"
                }
              ]
            }
          },
          "patter": {
            "line": {
              "fields": [
                {
                  "name": "to",
                  "type": "reference",
                  "to": "cast"
                }
              ]
            }
          }
        }
      },
      "problems": []
    },
