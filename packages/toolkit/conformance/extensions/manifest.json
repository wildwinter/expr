{
  "about": "Manifest validation. Each case gives a manifest and every problem manifestProblems reports for it, by path and code, in the order reported. A case with no problems is a manifest that must pass.",
  "cases": [
    {
      "name": "a minimal manifest passes",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [{ "name": "mood", "type": "text" }] } } } },
      "problems": []
    },
    {
      "name": "every type, a claim and a setting pass together",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "2.1.0",
        "docs": "https://example.com/probe",
        "settings": [{ "name": "moodField", "label": "Mood field", "default": "mood" }],
        "targets": {
          "storylets": {
            "card": {
              "fields": [
                { "name": "note", "type": "text", "label": "Note", "help": "A line for the crew." },
                { "name": "body", "type": "multiline", "editorOnly": true },
                { "name": "weight", "type": "number", "min": 0, "max": 10, "default": 1 },
                { "name": "loud", "type": "boolean", "required": true },
                { "name": "tone", "type": "enum", "values": ["calm", "tense"], "valueHelp": { "calm": "Unhurried." } },
                { "name": "marks", "type": "flags", "values": ["night", "rain"], "default": ["rain"] },
                { "name": "act", "type": "quality", "stages": ["setup", "turn", "close"], "renamedStages": { "opening": "setup" } },
                { "name": "next", "type": "reference", "to": "card" },
                { "name": "cue", "type": "record", "fields": [{ "name": "sound", "type": "text" }, { "name": "gain", "type": "number" }] },
                { "name": "byTag", "type": "map", "key": { "type": "reference", "to": "tag" }, "of": { "type": "number" } },
                { "name": "byName", "type": "map", "key": { "type": "text" }, "of": { "type": "record", "fields": [{ "name": "look", "type": "text" }] } },
                { "name": "beats", "type": "list", "id": "id", "of": { "type": "record", "fields": [{ "name": "id", "type": "text" }, { "name": "at", "type": "number" }] } },
                { "name": "words", "type": "list", "of": { "type": "text" } }
              ],
              "claims": [{ "setting": "moodField", "type": "enum", "values": ["calm", "tense"], "help": "The card's mood." }]
            },
            "project": { "fields": [{ "name": "studio", "type": "text" }] }
          },
          "patter": { "line": { "fields": [{ "name": "to", "type": "reference", "to": "cast" }] } }
        } },
      "problems": []
    },
    {
      "name": "identity is checked",
      "manifest": { "schema": "wildwinter/extension@1", "id": "Probe Two", "name": " ", "version": "1.0", "docs": 3,
        "targets": { "storylets": { "card": { "fields": [] } } } },
      "problems": [
        { "path": "schema", "code": "schema" },
        { "path": "id", "code": "id" },
        { "path": "name", "code": "name" },
        { "path": "version", "code": "version" },
        { "path": "docs", "code": "docs" }
      ]
    },
    {
      "name": "a manifest must target something it knows",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "ink": { "knot": {} }, "storylets": { "scene": {} } } },
      "problems": [
        { "path": "targets.ink", "code": "unknown-host" },
        { "path": "targets.storylets.scene", "code": "unknown-kind" }
      ]
    },
    {
      "name": "no targets at all",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0", "targets": {} },
      "problems": [{ "path": "targets", "code": "no-targets" }]
    },
    {
      "name": "field names are identifiers, once each",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [
          { "name": "mood", "type": "text" }, { "name": "mood", "type": "number" }, { "name": "9lives", "type": "text" }
        ] } } } },
      "problems": [
        { "path": "targets.storylets.card.fields[1].name", "code": "duplicate-field" },
        { "path": "targets.storylets.card.fields[2].name", "code": "field-name" }
      ]
    },
    {
      "name": "the text type is spelled text, and an unknown type is refused",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [
          { "name": "a", "type": "string" }, { "name": "b", "type": "colour" }
        ] } } } },
      "problems": [
        { "path": "targets.storylets.card.fields[0].type", "code": "string-type" },
        { "path": "targets.storylets.card.fields[1].type", "code": "unknown-type" }
      ]
    },
    {
      "name": "enum and flags values: some, none empty, none twice",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [
          { "name": "a", "type": "enum", "values": [] },
          { "name": "b", "type": "flags", "values": ["x", "", "x"] },
          { "name": "c", "type": "enum" }
        ] } } } },
      "problems": [
        { "path": "targets.storylets.card.fields[0].values", "code": "values-empty" },
        { "path": "targets.storylets.card.fields[1].values[1]", "code": "value-empty" },
        { "path": "targets.storylets.card.fields[1].values[2]", "code": "value-duplicate" },
        { "path": "targets.storylets.card.fields[2].values", "code": "values-empty" }
      ]
    },
    {
      "name": "a quality's ladder follows the kernel's rule",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [
          { "name": "a", "type": "quality", "stages": ["only"] },
          { "name": "b", "type": "quality", "stages": ["x", "x"] },
          { "name": "c", "type": "quality", "stages": ["x", "y"], "default": "z" }
        ] } } } },
      "problems": [
        { "path": "targets.storylets.card.fields[0].stages", "code": "quality-too-few-stages" },
        { "path": "targets.storylets.card.fields[1].stages", "code": "quality-duplicate-stage" },
        { "path": "targets.storylets.card.fields[2].default", "code": "default-misfit" }
      ]
    },
    {
      "name": "renamed stages map old names to current stages",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [
          { "name": "act", "type": "quality", "stages": ["setup", "turn"], "renamedStages": { "turn": "setup", "old": "gone" } },
          { "name": "tone", "type": "enum", "values": ["a", "b"], "renamedStages": { "x": "a" } }
        ] } } } },
      "problems": [
        { "path": "targets.storylets.card.fields[0].renamedStages.turn", "code": "renamed-stages" },
        { "path": "targets.storylets.card.fields[0].renamedStages.old", "code": "renamed-stages" },
        { "path": "targets.storylets.card.fields[1].renamedStages", "code": "renamed-stages" }
      ]
    },
    {
      "name": "value help names only values the field has",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [
          { "name": "tone", "type": "enum", "values": ["a", "b"], "valueHelp": { "a": "Fine.", "c": "No such value." } },
          { "name": "n", "type": "number", "valueHelp": { "1": "One." } }
        ] } } } },
      "problems": [
        { "path": "targets.storylets.card.fields[0].valueHelp.c", "code": "value-help" },
        { "path": "targets.storylets.card.fields[1].valueHelp", "code": "value-help" }
      ]
    },
    {
      "name": "a reference names a kind its host can point at",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": {
          "storylets": { "card": { "fields": [{ "name": "who", "type": "reference", "to": "cast" }, { "name": "where", "type": "reference" }] } },
          "patter": { "line": { "fields": [{ "name": "card", "type": "reference", "to": "card" }] } }
        } },
      "problems": [
        { "path": "targets.storylets.card.fields[0].to", "code": "reference-to" },
        { "path": "targets.storylets.card.fields[1].to", "code": "reference-to" },
        { "path": "targets.patter.line.fields[0].to", "code": "reference-to" }
      ]
    },
    {
      "name": "structured types need their parts",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [
          { "name": "r", "type": "record", "fields": [] },
          { "name": "m", "type": "map", "key": { "type": "number" }, "of": { "type": "text" } },
          { "name": "m2", "type": "map", "key": { "type": "text" } },
          { "name": "l", "type": "list", "id": "id", "of": { "type": "record", "fields": [{ "name": "at", "type": "number" }] } },
          { "name": "l2", "type": "list", "id": "id", "of": { "type": "text" } },
          { "name": "l3", "type": "list" }
        ] } } } },
      "problems": [
        { "path": "targets.storylets.card.fields[0].fields", "code": "record-empty" },
        { "path": "targets.storylets.card.fields[1].key", "code": "map-key" },
        { "path": "targets.storylets.card.fields[2].of", "code": "missing-of" },
        { "path": "targets.storylets.card.fields[3].id", "code": "list-id" },
        { "path": "targets.storylets.card.fields[4].id", "code": "list-id" },
        { "path": "targets.storylets.card.fields[5].of", "code": "missing-of" }
      ]
    },
    {
      "name": "problems inside a structured type are found where they are",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [
          { "name": "m", "type": "map", "key": { "type": "text" }, "of": { "type": "record", "fields": [
            { "name": "a", "type": "enum", "values": [] }, { "name": "a", "type": "text", "editorOnly": true }
          ] } }
        ] } } } },
      "problems": [
        { "path": "targets.storylets.card.fields[0].of.fields[0].values", "code": "values-empty" },
        { "path": "targets.storylets.card.fields[0].of.fields[1].name", "code": "duplicate-field" },
        { "path": "targets.storylets.card.fields[0].of.fields[1].editorOnly", "code": "editor-only-nested" }
      ]
    },
    {
      "name": "a given default must fit, in every type",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [
          { "name": "a", "type": "number", "default": "1" },
          { "name": "b", "type": "enum", "values": ["x"], "default": "y" },
          { "name": "c", "type": "enum", "values": ["x"], "default": "" },
          { "name": "d", "type": "flags", "values": ["x"], "default": ["x", "z"] },
          { "name": "e", "type": "number", "min": 1, "default": 0 },
          { "name": "f", "type": "record", "fields": [{ "name": "g", "type": "boolean" }], "default": { "g": 1 } },
          { "name": "h", "type": "list", "of": { "type": "number" }, "default": [1, "2"] }
        ] } } } },
      "problems": [
        { "path": "targets.storylets.card.fields[0].default", "code": "default-misfit" },
        { "path": "targets.storylets.card.fields[1].default", "code": "default-misfit" },
        { "path": "targets.storylets.card.fields[3].default", "code": "default-misfit" },
        { "path": "targets.storylets.card.fields[4].default", "code": "default-misfit" },
        { "path": "targets.storylets.card.fields[5].default", "code": "default-misfit" },
        { "path": "targets.storylets.card.fields[6].default", "code": "default-misfit" }
      ]
    },
    {
      "name": "ranges apply to numbers and run upwards",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [
          { "name": "a", "type": "number", "min": 5, "max": 1 },
          { "name": "b", "type": "text", "max": 3 }
        ] } } } },
      "problems": [
        { "path": "targets.storylets.card.fields[0].max", "code": "range" },
        { "path": "targets.storylets.card.fields[1].max", "code": "range" }
      ]
    },
    {
      "name": "a misspelt attribute is a warning, not silence",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "targets": { "storylets": { "card": { "fields": [{ "name": "a", "type": "text", "requird": true }] } } } },
      "problems": [{ "path": "targets.storylets.card.fields[0].requird", "code": "unknown-key", "severity": "warning" }]
    },
    {
      "name": "claims: a claimable kind, a declared setting, a scalar, once per setting",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "settings": [{ "name": "moodField", "default": "mood" }],
        "targets": {
          "storylets": {
            "deck": { "claims": [{ "setting": "moodField", "type": "text" }] },
            "card": { "claims": [
              { "setting": "moodField", "type": "text" },
              { "setting": "moodField", "type": "text" },
              { "setting": "nope", "type": "text" },
              { "setting": "moodField", "type": "record", "fields": [{ "name": "a", "type": "text" }] }
            ] }
          }
        } },
      "problems": [
        { "path": "targets.storylets.deck.claims[0]", "code": "claim-kind" },
        { "path": "targets.storylets.card.claims[1].setting", "code": "claim-duplicate" },
        { "path": "targets.storylets.card.claims[2].setting", "code": "claim-setting" },
        { "path": "targets.storylets.card.claims[3].type", "code": "claim-type" },
        { "path": "targets.storylets.card.claims[3].setting", "code": "claim-duplicate" }
      ]
    },
    {
      "name": "settings: named once each, defaulting to a field name",
      "manifest": { "schema": "wildwinter/extension@0", "id": "probe", "name": "Probe", "version": "1.0.0",
        "settings": [{ "name": "a", "default": "x" }, { "name": "a", "default": "y" }, { "name": "b" }, { "name": "c", "default": "not a name" }],
        "targets": { "storylets": { "card": {} } } },
      "problems": [
        { "path": "settings[1].name", "code": "setting-duplicate" },
        { "path": "settings[2].default", "code": "setting-default" },
        { "path": "settings[3].default", "code": "setting-default" }
      ]
    }
  ]
}
